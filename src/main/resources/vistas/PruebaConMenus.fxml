<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="223.0" prefWidth="262.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.iesalandalus.programacion.javafx.controladores.PruebaConMenus">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Aplicación">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#miCerrarPrograma" text="Cerrar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Editar">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#miListarUsuarios" text="ListarUsuarios" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ayuda">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#miAcercaDe" text="Acerca de..." />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <Button mnemonicParsing="false" onAction="#abrirPrueba" text="Abrir Prueba">
         <VBox.margin>
            <Insets left="80.0" top="75.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
